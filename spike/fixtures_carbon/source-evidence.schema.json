{
  "$id": "https://carboneg.example/schema/source-evidence/1.0.0/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Source-system facts about carbon-project entities. Entity identifiers (farm_key, plot_key) are claim content; retrieval coordinates (which Airtable row / workbook produced the fact) belong to the witnessed submission record, not here. Hand-authored as-if generated from a LinkML claim-type schema.",
  "oneOf": [
    {
      "additionalProperties": false,
      "properties": {
        "active_acreage": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "country_iso": {
          "maxLength": 2,
          "minLength": 2,
          "type": "string"
        },
        "farm_key": {
          "pattern": "^[0-9.]+$",
          "type": "string"
        },
        "holder": {
          "minLength": 1,
          "type": "string"
        },
        "land_use": {
          "minLength": 1,
          "type": "string"
        },
        "plot_count": {
          "minimum": 1,
          "type": "integer"
        },
        "plots": {
          "items": {
            "format": "uri",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "site": {
          "format": "uri",
          "type": "string"
        },
        "type": {
          "const": "SiteRecord"
        }
      },
      "required": [
        "type",
        "site",
        "farm_key",
        "country_iso",
        "land_use",
        "active_acreage",
        "plot_count",
        "plots",
        "holder"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "acreage_hectares": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "land_use": {
          "minLength": 1,
          "type": "string"
        },
        "part_of_site": {
          "format": "uri",
          "type": "string"
        },
        "plot": {
          "format": "uri",
          "type": "string"
        },
        "plot_key": {
          "pattern": "^[0-9.]+$",
          "type": "string"
        },
        "registration_id": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "PlotRecord"
        }
      },
      "required": [
        "type",
        "plot",
        "plot_key",
        "part_of_site",
        "land_use",
        "acreage_hectares",
        "registration_id"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "earliest_sampling_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "record_count": {
          "minimum": 1,
          "type": "integer"
        },
        "site": {
          "format": "uri",
          "type": "string"
        },
        "type": {
          "const": "SamplingSummary"
        }
      },
      "required": [
        "type",
        "site",
        "record_count",
        "earliest_sampling_date"
      ],
      "type": "object"
    }
  ],
  "title": "SourceEvidence"
}
